{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/secrets.sh\" SessionStart"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/secrets.sh\" PreToolUse",
            "timeout": 90
          }
        ],
        "matcher": "Bash"
      }
    ]
  }
}
