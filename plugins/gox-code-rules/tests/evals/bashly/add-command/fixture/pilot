normalize_input() {
  local arg passthru flags
  passthru=false

  while [[ $# -gt 0 ]]; do
    arg="$1"
    if [[ $passthru == true ]]; then
      input+=("$arg")
    elif [[ $arg =~ ^(--[a-zA-Z0-9_\-]+)=(.+)$ ]]; then
      input+=("${BASH_REMATCH[1]}")
      input+=("${BASH_REMATCH[2]}")
    elif [[ $arg =~ ^(-[a-zA-Z0-9])=(.+)$ ]]; then
      input+=("${BASH_REMATCH[1]}")
      input+=("${BASH_REMATCH[2]}")
    elif [[ $arg =~ ^-([a-zA-Z0-9][a-zA-Z0-9]+)$ ]]; then
      flags="${BASH_REMATCH[1]}"
      for ((i = 0; i < ${#flags}; i++)); do
        input+=("-${flags:i:1}")
      done
    elif [[ "$arg" == "--" ]]; then
      passthru=true
      input+=("$arg")
    else
      input+=("$arg")
    fi

    shift
  done
}

# 条目存放在 ITEMS_DIR（默认 ./items）下，每个文件一条
items_dir() {
  echo "${ITEMS_DIR:-./items}"
}

items_list() {
  local dir="${1}" limit="${2:-0}" count=0 f
  [[ -d "${dir}" ]] || return 0
  for f in "${dir}"/*; do
    [[ -f "${f}" ]] || continue
    basename "${f}"
    count=$((count + 1))
    if [[ "${limit}" -gt 0 && "${count}" -ge "${limit}" ]]; then break; fi
  done
}

items_to_json() {
  jq -R . | jq -sc .
}

pilot_list_command() {

  limit="${args[--limit]:-0}"
  if [[ -n "${args[--json]:-}" ]]; then
    items_list "$(items_dir)" "${limit}" | items_to_json
  else
    items_list "$(items_dir)" "${limit}"
  fi

}

pilot_show_command() {

  file="$(items_dir)/${args[target]}"
  [[ -f "${file}" ]] || { echo "Error: no such item: ${args[target]}" >&2; exit 1; }
  if [[ -n "${args[--json]:-}" ]]; then
    jq -n --arg name "${args[target]}" --rawfile body "${file}" '{name: $name, body: $body}'
  else
    cat "${file}"
  fi

}

pilot_remove_command() {

  file="$(items_dir)/${args[target]}"
  [[ -f "${file}" ]] || { echo "Error: no such item: ${args[target]}" >&2; exit 1; }
  if [[ -n "${args[--dry-run]:-}" ]]; then
    echo "would remove ${args[target]}"
    exit 0
  fi
  [[ -n "${args[--force]:-}" ]] || { echo "Error: refusing to remove ${args[target]} without --force" >&2; exit 1; }
  rm "${file}"
  echo "removed ${args[target]}"

}

