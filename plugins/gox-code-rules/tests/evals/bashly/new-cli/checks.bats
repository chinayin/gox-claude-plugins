#!/usr/bin/env bats
# 明确要求 bashly 的新 CLI：按 bashly 技能的结构和规则来。
bats_require_minimum_version 1.5.0
load ../../helpers

setup() {
  eval_setup
  CLI="$WORK/notes"
}

@test "loads bashly" {
  require_plugin_run
  skill_loaded bashly
}

@test "loads shell as well" {
  require_plugin_run
  skill_loaded shell
}

@test "has the bashly layout" {
  [ -f "$WORK/src/bashly.yml" ]
  [ -f "$WORK/settings.yml" ]
  [ -n "$(find "$WORK/src/lib" -name '*.sh' 2>/dev/null)" ]
  [ -n "$(find "$WORK/tests" -name '*.bats' 2>/dev/null)" ]
}

@test "settings select the production build, strict mode and no colors" {
  grep -qE '^env:[[:space:]]*production' "$WORK/settings.yml"
  grep -qE '^strict:[[:space:]]*true' "$WORK/settings.yml"
  run grep -rnE '^[[:space:]]*(caption|command|arg|flag|environment_variable):[[:space:]]*[a-z]' "$WORK/settings.yml"
  [ "$status" -ne 0 ]
  [ ! -e "$WORK/src/lib/colors.sh" ]
}

@test "generated script is committed, production build, not hand-edited" {
  sed -n 2p "$CLI" | grep -q 'generated by bashly'
  artifact_is_current "$WORK"
}

@test "shellcheck is clean on the generated script" {
  shellcheck "$CLI"
}

@test "no emoji or color in src" {
  no_emoji_or_color "$WORK"/src/*.sh "$WORK"/src/lib/*.sh
}

@test "--json is declared once and shared by anchor or import" {
  [ "$(grep -cE '^[[:space:]]*(-[[:space:]]*)?long:[[:space:]]*--json' "$WORK/src/bashly.yml")" -le 1 ]
  grep -qE '^[[:space:]]*-[[:space:]]*(\*[A-Za-z_]+|import:)' "$WORK/src/bashly.yml"
}

@test "framework errors carry the Error: prefix" {
  cd "$BATS_TEST_TMPDIR"
  run --separate-stderr "$CLI" list --nope
  [ "$status" -eq 1 ]
  [[ "$stderr" == "Error: "* ]]
}

@test "optional flags are read with a default" {
  run unguarded_optional_flags "$WORK/src"
  [ "$status" -eq 0 ]
  [ -z "$output" ]
}

@test "the project's own bats tests pass" {
  cd "$WORK"
  HOME="$BATS_TEST_TMPDIR" run bats tests/
  [ "$status" -eq 0 ]
}

@test "list --json emits pure JSON on stdout" {
  cd "$BATS_TEST_TMPDIR"
  mkdir notes
  run --separate-stderr "$CLI" add first
  [ "$status" -eq 0 ]
  run --separate-stderr "$CLI" list --json
  [ "$status" -eq 0 ]
  jq -e . <<<"$output" >/dev/null
  [[ "$output" == *first* ]]
}

@test "remove refuses without --force" {
  cd "$BATS_TEST_TMPDIR"
  mkdir notes
  run "$CLI" add first
  run "$CLI" remove first
  [ "$status" -ne 0 ]
  [ -n "$(find notes -type f)" ]
}

@test "unknown option exits 1" {
  cd "$BATS_TEST_TMPDIR"
  run -1 "$CLI" list --nope
}
