#!/usr/bin/env bats
# 没提 bashly 的多子命令 CLI：仍然手写，不自行改用 bashly。
bats_require_minimum_version 1.5.0
load ../../helpers

setup() {
  eval_setup
  SCRIPT="$(find_file deployctl deployctl.sh)"
}

@test "loads shell" {
  require_plugin_run
  skill_loaded shell
}

@test "does not pick bashly on its own" {
  run find "$WORK" -name bashly.yml
  [ -z "$output" ]
  run grep -l 'generated by bashly' "$SCRIPT"
  [ "$status" -ne 0 ]
}

@test "script has the team header" {
  has_header "$SCRIPT"
}

@test "shellcheck is clean" {
  shellcheck "$SCRIPT"
}

@test "no emoji or color" {
  no_emoji_or_color "$SCRIPT"
}

@test "unknown subcommand exits 1 with Error: on stderr" {
  cd "$BATS_TEST_TMPDIR"
  run --separate-stderr bash "$SCRIPT" bogus
  [ "$status" -eq 1 ]
  [[ "$stderr" == *"Error: "* ]]
}

@test "--help exits 0 on stdout" {
  run --separate-stderr bash "$SCRIPT" --help
  [ "$status" -eq 0 ]
  [ -n "$output" ]
}

@test "apply then status reports the applied release on stdout" {
  cd "$BATS_TEST_TMPDIR"
  mkdir -p releases/v1 releases/v2
  run bash "$SCRIPT" apply v2
  [ "$status" -eq 0 ]
  run --separate-stderr bash "$SCRIPT" status
  [ "$status" -eq 0 ]
  [[ "$output" == *v2* ]]
}

@test "ships a passing test.sh" {
  t="$(find_file test.sh)"
  cd "$(dirname "$t")"
  HOME="$BATS_TEST_TMPDIR" run bash "$t"
  [ "$status" -eq 0 ]
}
