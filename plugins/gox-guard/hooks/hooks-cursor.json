{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "bash ./hooks/cursor-secrets.sh SessionStart"
      }
    ],
    "preToolUse": [
      {
        "command": "bash ./hooks/cursor-secrets.sh PreToolUse",
        "matcher": "Shell",
        "timeout": 90
      }
    ]
  }
}
